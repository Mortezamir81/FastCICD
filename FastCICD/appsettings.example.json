{
  "DeployerSettings": {
    "ServerEndpoint": "https://your-server-domain.com",
    "SecurityKey": "REPLACE_WITH_YOUR_LONG_SECRET_KEY",
    "Projects": [
      {
        "Name": "SampleProject1",
        "Group": "Sample Website",
        "LocalSourcePath": "C:\\Path\\To\\Your\\Local\\Project\\Publish",
        "EnableRollback": true,
        "MigrationProfile": "MyAwesomeWebsiteDb",
        "MigrationExecutionKey": "A_SECOND_LONG_RANDOM_SECRET_USED_ONLY_FOR_MIGRATIONS",
        "MigrationScriptPath": "C:\\Path\\To\\Your\\Local\\Project\\database\\migrations.sql",
        "MirrorServerToLocal": false,
        "ServicesToManage": [ "W3SVC" ],
        "IgnoredFiles": [
          "appsettings.Development.json"
        ],
        "LocalPreDeployCommands": [
          {
            "Command": "dotnet clean -c Release",
            "WorkingDirectory": "C:\\Path\\To\\Your\\Local\\Project"
          },
          {
            "Command": "dotnet publish -c Release -o \"C:\\Path\\To\\Your\\Local\\Project\\Publish\"",
            "WorkingDirectory": "C:\\Path\\To\\Your\\Local\\Project"
          }
        ],
        "LocalPostDeployCommands": [],
        "PreDeployCommands": [],
        "PostDeployCommands": []
      }
    ]
  }
}
