{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://*:10404"
      }
    }
  },
  "AllowedClientIp": "192.168.1.100", // Leave empty "" to rely solely on HMAC Dynamic Security
  "SecurityKey": "YOUR_SUPER_SECRET_KEY_HERE_MAKE_IT_LONG",
  "HmacValidityMinutes": 5,
  "UploadHmacValidityMinutes": 120,
  "MigrationExecutionKey": "A_SECOND_LONG_RANDOM_SECRET_USED_ONLY_FOR_MIGRATIONS",
  "RequireHttpsForMigrations": true,
  "MigrationScriptStorageDirectory": "C:\\ProgramData\\FastCICD\\Migrations",
  "MigrationMaxScriptBytes": 52428800,
  "MaxUploadBytes": 10737418240,
  "UploadDiagnosticsLogPath": "C:\\Data\\DeployBackups\\fastcicd-upload-diagnostics.log",
  "BackupDirectory": "C:\\Deployments\\Backups",
  "AllowedDirectories": {
    "MyAwesomeWebsite": "C:\\inetpub\\wwwroot\\MyAwesomeWebsite",
    "MyWorkerService": "C:\\Services\\WorkerService"
  },
  "AllowedServices": [
    "W3SVC",
    "MyCustomWindowsService"
  ],
  "MigrationProfiles": {
    "MyAwesomeWebsiteDb": {
      "ConnectionString": "Server=localhost;Database=MyAwesomeWebsite;User Id=fastcicd_migrator;Password=REPLACE_ME;Encrypt=True;TrustServerCertificate=False",
      "CommandTimeoutSeconds": 300
    }
  }
}
